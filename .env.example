# ==============================================================================
# TierMax Gateway — Environment Configuration Example
# ==============================================================================

# Server Port
PORT=3000

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Option 1: LOCAL ZERO-CONFIG MODE (Recommended for quick local setup & testing)
# No external services, no cloud accounts, and no internet required.
DB_TYPE=sqlite
SQLITE_DB_PATH=./data/tiermax.db

# Option 2: SUPABASE CLOUD MODE
# Uncomment the lines below to use Supabase instead of Local SQLite:
# DB_TYPE=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI...

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
ADMIN_JWT_SECRET=super-secret-jwt-key-change-me-in-production
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin

# ------------------------------------------------------------------------------
# OPTIONAL: SYSTEM 1 (TypeSafe AI / Jev Routing)
# ------------------------------------------------------------------------------
# ENABLE_JEV_ROUTING=true
# TYPESAFE_ENDPOINT=https://openrouter.ai/api/alpha/decisions
# TYPESAFE_MODEL=~typesafe/jev-latest
# TYPESAFE_API_KEY=sk-or-v1-...
